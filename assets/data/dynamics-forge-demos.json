    {
      "id": "two_link",
      "order": 0,
      "shortTitle": "Arm",
      "title": "2-DoF manipulator tracking",
      "category": "Multibody manipulator",
      "description": "Tune independent joint PID gains and rerun a nonlinear two-link rigid-body model using the Dynamics Forge forearm and link CAD.",
      "controller": "PID joint control",
      "duration": 12,
      "stateStride": 4,
      "plotStateIndex": 0,
      "secondaryPlotStateIndex": 1,
      "primaryMetricLabel": "Joint 1 RMS",
      "secondaryMetricLabel": "Joint 2 RMS",
      "camera": { "yaw": -0.72, "pitch": 0.38, "zoom": 1.08 },
      "bounds": { "min": [-0.7, -0.42, -0.2], "max": [0.7, 0.42, 0.75] },
      "controls": [
        { "key": "kp1", "label": "Kp joint 1", "unit": "", "default": 35, "min": 0, "max": 80, "step": 1 },
        { "key": "kp2", "label": "Kp joint 2", "unit": "", "default": 35, "min": 0, "max": 80, "step": 1 },
        { "key": "kd1", "label": "Kd joint 1", "unit": "", "default": 8, "min": 0, "max": 20, "step": 0.25 },
        { "key": "kd2", "label": "Kd joint 2", "unit": "", "default": 8, "min": 0, "max": 20, "step": 0.25 },
        { "key": "ki1", "label": "Ki joint 1", "unit": "", "default": 1.2, "min": 0, "max": 5, "step": 0.1 },
        { "key": "ki2", "label": "Ki joint 2", "unit": "", "default": 0.4, "min": 0, "max": 5, "step": 0.1 },
        { "key": "amplitude", "label": "Motion amplitude", "unit": "rad", "default": 0.55, "min": 0.1, "max": 0.9, "step": 0.05 }
      ],
      "meshes": [
        { "key": "forearm", "url": "assets/models/dynamics-forge/forearm.stl" },
        { "key": "link", "url": "assets/models/dynamics-forge/link.stl" }
      ]
    },
